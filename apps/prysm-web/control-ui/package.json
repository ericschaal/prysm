{
  "name": "prysm-control-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate-api": "node generate-schema.mjs && openapi-typescript openapi.json -o api.generated.ts",
    "check-api": "node generate-schema.mjs --check && openapi-typescript openapi.json -o api.generated.ts --check",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "npm run check-api && npm run build && node ../tests/control-page.test.cjs && node --test dev-proxy.test.mjs"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "jsdom": "^27.0.0",
    "vite": "^8.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^24.0.0",
    "openapi-typescript": "^7.13.0"
  }
}
