        ],
        "type": "object"
      },
      "CalibrationPresentation": {
        "description": "These private presentation messages never appear in ClientSnapshot.",
        "properties": {
          "pairing": {
            "type": "string"
          },
          "pattern": {
            "$ref": "#/components/schemas/PatternRequest"
          },
          "session": {
            "type": "string"
          }
        },
        "required": [
          "session",
          "pairing",
          "pattern"
        ],
        "type": "object"
      },
      "CaptureCapabilities": {
        "properties": {
          "supports_patterns": {
            "description": "Whether this source supports calibration using presented test patterns.",
            "type": "boolean"
          }
        },
        "required": [
          "supports_patterns"
        ],
        "type": "object"
      },
      "ClientFailure": {
        "oneOf": [
