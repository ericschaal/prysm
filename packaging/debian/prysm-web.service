[Unit]
Description=Prysm web UI
Wants=network-online.target prysm.service
After=network-online.target prysm.service

[Service]
Type=simple
DynamicUser=true
ExecStart=/usr/bin/prysm-web
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
