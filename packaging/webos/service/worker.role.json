{
  "exeName": "/media/developer/apps/usr/palm/services/io.prysm.tv.service/prysm-webos-worker",
  "type": "regular",
  "allowedNames": [
    "com.webos.service.capture.client*",
    "com.webos.rm.client.*"
  ],
  "permissions": [
    {
      "service": "com.webos.service.capture.client*",
      "outbound": [
        "com.webos.service.capture",
        "com.webos.service.capturepermission"
      ]
    },
    {
      "service": "com.webos.rm.client.*",
      "outbound": [
        "com.webos.media"
      ]
    }
  ]
}
