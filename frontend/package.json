{
  "name": "prysm-frontend",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "codegen": "node scripts/codegen.mjs",
    "codegen:check": "node scripts/codegen.mjs --check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e && tsc --noEmit -p e2e-tv",
    "bundle": "node scripts/build.mjs",
    "test": "node --test tests/contracts.test.mjs && vite build --config tests/vite.config.mjs && NODE_OPTIONS=--max-old-space-size=2048 node --import ./tests/watchdog.js --import ./tests/setup-dom.js --test --test-concurrency=2 --test-timeout=60000 .test/*.test.js",
    "dev:headless": "vite hosts/headless/web-portal --config dev.config.mjs --host 127.0.0.1",
    "dev:webos": "vite hosts/webos/tv-ui --host 127.0.0.1",
    "dev:webos-slim": "vite hosts/webos-slim/tv-ui --host 127.0.0.1",
    "dev:webos-portal": "vite hosts/webos/web-portal --config dev.config.mjs --host 127.0.0.1",
    "e2e": "playwright test -c e2e --project chromium --project webkit",
    "e2e:tv": "playwright test -c e2e-tv --workers=2",
    "e2e:install": "playwright install chromium webkit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\""
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tanstack/intent": "^0.5.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "jsqr": "1.4.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  },
  "intent": {
    "skills": [
      "*"
    ]
  },
  "overrides": {
    "minimatch@^10": "11.0.1"
  }
}
