diff --git a/crates/capture/prysm-capture/src/receiver/websocket.rs b/crates/capture/prysm-capture/src/receiver/websocket.rs
new file mode 100644
index 0000000..7188884
--- /dev/null
+++ b/crates/capture/prysm-capture/src/receiver/websocket.rs
@@ -0,0 +1,120 @@
+//! Staged direct receiver. Only one test sender connects at a time.
+use super::{Request, WebosReceiver, finish, stop_requested};
+use anyhow::{Context, Result, ensure};
+use axum::{
+    Router,
+    extract::{
+        ConnectInfo,
+        ws::{Message, WebSocket, WebSocketUpgrade},
+    },
+    routing::get,
+};
+use futures::{StreamExt, TryStreamExt};
+use prysm_webos_protocol::{ControlMessage, HEADER_LEN, HELLO, Header};
+use std::{net::SocketAddr, time::Duration};
+use tokio::sync::mpsc;
+use tokio_util::io::StreamReader;
+
+pub(super) struct Incoming {
+    socket: WebSocket,
+    peer: SocketAddr,
+}
+
+impl WebosReceiver {
+    pub fn router(&self) -> Router {
+        let sockets = self.sockets.clone();
+        Router::new().route(
+            "/api/capture",
+            get(
+                move |ConnectInfo(peer): ConnectInfo<SocketAddr>, ws: WebSocketUpgrade| async move {
+                    ws.max_message_size(8_388_608 + HEADER_LEN)
+                        .max_frame_size(8_388_608 + HEADER_LEN)
+                        .on_upgrade(move |socket| async move {
+                            let _ = sockets.try_send(Incoming { socket, peer });
+                        })
+                },
+            ),
+        )
+    }
+}
+
+fn frame(message: Message) -> Result<axum::body::Bytes> {
+    let Message::Binary(bytes) = message else {
+        anyhow::bail!("expected binary capture frame")
+    };
+    let header = bytes.get(..HEADER_LEN).context("truncated frame header")?;
+    ensure!(
+        Header::decode(header.try_into()?)?.payload_len == bytes.len() - HEADER_LEN,
+        "incorrect frame length"
+    );
+    Ok(bytes)
+}
+
+pub(super) async fn receive(
+    incoming: Incoming,
+    active: &mut Option<Request>,
+    requests: &mut mpsc::Receiver<Request>,
+) -> Result<()> {
+    let Incoming { mut socket, peer } = incoming;
+    let Some(Ok(Message::Binary(bytes))) =
+        tokio::time::timeout(Duration::from_secs(2), socket.recv()).await?
+    else {
+        anyhow::bail!("expected Prysm handshake")
+    };
+    ensure!(
+        ControlMessage::decode(&bytes)? == HELLO,
+        "invalid Prysm handshake"
+    );
+    if active.is_none() {
+        socket
+            .send(Message::Binary(
+                serde_json::to_vec(&ControlMessage::Idle)?.into(),
+            ))
+            .await?;
+        tokio::select! {
+            request = requests.recv() => *active = request.map(Request::activate),
+            _ = socket.recv() => return Ok(()),
+        }
+    }
+    let Some(request) = active.as_ref() else {
+        return Ok(());
+    };
+    socket
+        .send(Message::Binary(
+            serde_json::to_vec(&request.settings)?.into(),
+        ))
+        .await?;
+    let messages = socket.map(|message| {
+        let message = message.map_err(std::io::Error::other)?;
+        frame(message).map_err(std::io::Error::other)
+    });
+    let mut last = None;
+    let mut reader = StreamReader::new(messages.into_stream());
+    tokio::select! {
+        () = stop_requested(Some(request)) => finish(active),
+        () = crate::webos::receive_frames(&mut reader, &request.frames, &request.receiving, peer, &mut last) => {}
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use prysm_webos_protocol::{Codec, PixelFormat};
+    #[test]
+    fn binary_message_contains_exactly_one_complete_frame() {
+        let header = Header {
+            width: 2,
+            height: 2,
+            codec: Codec::Raw,
+            format: PixelFormat::Rgb,
+            payload_len: 12,
+        };
+        let mut bytes = header.encode().unwrap().to_vec();
+        assert!(frame(Message::Binary(bytes.clone().into())).is_err());
+        bytes.extend_from_slice(&[0; 12]);
+        assert!(frame(Message::Binary(bytes.clone().into())).is_ok());
+        bytes.push(0);
+        assert!(frame(Message::Binary(bytes.into())).is_err());
+    }
+}
