+
+/// Benchmark-only TLS termination in the RP5 receiver process.
+async fn serve_tls(
+    listener: TcpListener,
+    router: Router,
+    shutdown: CancellationToken,
+) -> Result<()> {
+    use tokio_rustls::{
+        TlsAcceptor,
+        rustls::{
+            ServerConfig,
+            crypto::ring,
+            pki_types::{CertificateDer, PrivatePkcs8KeyDer},
+        },
+    };
+    let config = ServerConfig::builder_with_provider(ring::default_provider().into())
+        .with_safe_default_protocol_versions()?
+        .with_no_client_auth()
+        .with_single_cert(
+            vec![CertificateDer::from(std::fs::read("leaf.der")?)],
+            PrivatePkcs8KeyDer::from(std::fs::read("leaf-key.der")?).into(),
+        )?;
+    let acceptor = TlsAcceptor::from(std::sync::Arc::new(config));
+    loop {
+        let (socket, peer) = tokio::select! {
+            () = shutdown.cancelled() => return Ok(()),
+            connection = listener.accept() => connection?,
+        };
+        let router = router
+            .clone()
+            .layer(axum::Extension(axum::extract::ConnectInfo(peer)));
+        let acceptor = acceptor.clone();
+        tokio::spawn(async move {
+            let result: Result<()> = async {
+                let tls = tokio::time::timeout(Duration::from_secs(5), acceptor.accept(socket)).await??;
+                tracing::info!(%peer, tls_version = ?tls.get_ref().1.protocol_version(), "benchmark direct TLS accepted");
+                hyper::server::conn::http1::Builder::new()
+                    .serve_connection(hyper_util::rt::TokioIo::new(tls), hyper_util::service::TowerToHyperService::new(router))
+                    .with_upgrades().await?;
+                Ok(())
+            }.await;
+            if let Err(error) = result {
+                tracing::debug!(%peer, %error, "TLS connection ended");
+            }
+        });
     }
 }
 
