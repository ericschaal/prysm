{
  "name": "prysm-v1-frontend",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run codegen && npm run typecheck && node scripts/build.mjs",
    "test": "npm run build && node --test tests/contracts.test.mjs && vite build --ssr tests/composition.test.jsx --outDir .test && node --import ./tests/setup-dom.js --test .test/composition.test.js",
    "dev:headless": "npm run codegen && vite hosts/headless/web-portal --config dev.config.mjs --host 127.0.0.1",
    "dev:webos": "npm run codegen && vite hosts/webos/tv-ui --host 127.0.0.1",
    "codegen": "node scripts/codegen.mjs",
    "codegen:check": "node scripts/codegen.mjs --check",
    "dev:webos-slim": "npm run codegen && vite hosts/webos-slim/tv-ui --host 127.0.0.1",
    "dev:webos-portal": "npm run codegen && vite hosts/webos/web-portal --config dev.config.mjs --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\""
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@tanstack/intent": "^0.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "27.4.0",
    "jsqr": "1.4.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  },
  "intent": {
    "skills": [
      "*"
    ]
  },
  "overrides": {
    "minimatch@^10": "11.0.1"
  }
}
