{
  "name": "prysm-v1-frontend",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run codegen && npm run typecheck && node scripts/build.mjs",
    "test": "npm run build && node --test tests/contracts.test.mjs && vite build --ssr tests/composition.test.jsx --outDir .test && node --test .test/composition.test.js",
    "dev:headless": "npm run codegen && vite hosts/headless/web-portal --host 127.0.0.1",
    "dev:webos": "npm run codegen && vite hosts/webos/tv-ui --host 127.0.0.1",
    "codegen": "node scripts/codegen.mjs",
    "codegen:check": "node scripts/codegen.mjs --check",
    "dev:webos-slim": "npm run codegen && vite hosts/webos-slim/tv-ui --host 127.0.0.1",
    "dev:webos-portal": "npm run codegen && vite hosts/webos/web-portal --host 127.0.0.1"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tanstack/intent": "^0.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "jsdom": "27.4.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "intent": {
    "skills": [
      "*"
    ]
  }
}
