[Unit]
Description=Prysm WLED capture
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=prysm
SupplementaryGroups=video
ExecStart=/usr/bin/prysm-led --config /etc/prysm/led.toml
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
