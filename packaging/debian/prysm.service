[Unit]
Description=Prysm capture, rendering, and REST API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=prysm
SupplementaryGroups=video
ExecStart=/usr/bin/prysm --config /etc/prysm/prysm.toml
ReadWritePaths=/etc/prysm
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
