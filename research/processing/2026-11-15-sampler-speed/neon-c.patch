diff --git a/crates/processor/build.rs b/crates/processor/build.rs
new file mode 100644
index 0000000..f5d080a
--- /dev/null
+++ b/crates/processor/build.rs
@@ -0,0 +1,42 @@
+//! Compiles the NEON cell-sum kernel (`src/frames/nv12_neon.c`) on CPUs with
+//! NEON and sets `cfg(prysm_neon)` for `frame_view.rs`; elsewhere nothing is
+//! compiled and the Rust loop is used. Research build: `PRYSM_NEON=off`
+//! disables the kernel, `PRYSM_NEON=arith` selects the table-free curve and
+//! `PRYSM_NEON=cell` calls the kernel cell by cell instead of per row band.
+
+fn main() {
+    println!("cargo::rustc-check-cfg=cfg(prysm_neon, prysm_neon_arith, prysm_neon_per_cell)");
+    println!("cargo::rerun-if-changed=src/frames/nv12_neon.c");
+    println!("cargo::rerun-if-env-changed=PRYSM_NEON");
+    let arch = std::env::var("CARGO_CFG_TARGET_ARCH").unwrap_or_default();
+    let features = std::env::var("CARGO_CFG_TARGET_FEATURE").unwrap_or_default();
+    // Cargo leaves CARGO_CFG_TARGET_FEATURE empty for the armv7 cross build
+    // (seen with packaging/webos/env.sh), so its `+neon` flag is read too.
+    let flags = std::env::var("CARGO_ENCODED_RUSTFLAGS").unwrap_or_default();
+    let arm_neon = features.split(',').any(|f| f == "neon")
+        || flags.split(['\x1f', ',']).any(|f| f == "+neon");
+    let neon = arch == "aarch64" || (arch == "arm" && arm_neon);
+    let variant = std::env::var("PRYSM_NEON").unwrap_or_default();
+    if !neon || variant == "off" {
+        return;
+    }
+    let mut build = cc::Build::new();
+    build.file("src/frames/nv12_neon.c").opt_level(3);
+    // The NEON is written out; GCC's own vectorisation of the scalar cell
+    // sums went through the stack and was slower than the scalar loop.
+    build.flag_if_supported("-fno-tree-vectorize");
+    build.flag_if_supported("-fno-tree-slp-vectorize");
+    if arch == "arm" {
+        // cc already passes -march=armv7-a+simd; schedule for the TV's core.
+        build.flag("-mtune=cortex-a9");
+    }
+    if variant == "arith" {
+        build.define("PRYSM_NEON_ARITH", None);
+        println!("cargo::rustc-cfg=prysm_neon_arith");
+    }
+    if variant == "cell" {
+        println!("cargo::rustc-cfg=prysm_neon_per_cell");
+    }
+    build.compile("prysm_nv12_neon");
+    println!("cargo::rustc-cfg=prysm_neon");
+}
diff --git a/crates/processor/src/frames/nv12_neon.c b/crates/processor/src/frames/nv12_neon.c
new file mode 100644
index 0000000..16ef16e
--- /dev/null
+++ b/crates/processor/src/frames/nv12_neon.c
@@ -0,0 +1,197 @@
+/*
+ * Linear-light sums of NV12 cells with NEON (armv7 with NEON, aarch64).
+ *
+ * The contract is prysm_nv12_cell_sums below; frame_view.rs is the only
+ * caller. YUV to 8-bit RGB is bit-exact with prysm_core::YuvToRgb (13-bit
+ * fixed point, 32-bit lanes). Linear light is in units of 2^-20:
+ *
+ * - default: 8-bit RGB is stored, then each channel is looked up in the
+ *   caller's 2^20 table and summed by scalar code (exact table values);
+ * - PRYSM_NEON_ARITH: the sRGB curve is a degree-5 f32 polynomial in NEON
+ *   (within 2.1e-5 of the exact curve), with no table; only the sums are
+ *   scalar.
+ *
+ * Sums cannot overflow: a chunk sums at most CHUNK pixels of at most 2^20
+ * each in u32 (2^27), then adds to the caller's u64.
+ */
+#include <arm_neon.h>
+#include <stddef.h>
+#include <stdint.h>
+
+typedef struct {
+    int32_t bias, y, r_v, g_v, g_u, b_u;
+} prysm_yuv;
+
+/* Pixels converted at a time; a multiple of 16. */
+#define CHUNK 128
+#define PRECISION 13
+#define ROUND (1 << (PRECISION - 1))
+
+#ifdef PRYSM_NEON_ARITH
+typedef uint32_t sample; /* linear light, 2^-20 */
+#else
+typedef uint8_t sample; /* 8-bit sRGB code */
+#endif
+
+static inline uint8_t channel(int32_t value) {
+    value = (value + ROUND) >> PRECISION;
+    return (uint8_t)(value < 0 ? 0 : value > 255 ? 255 : value);
+}
+
+#ifdef PRYSM_NEON_ARITH
+/* Degree-5 fit of the IEC 61966-2-1 decoding over codes 11..255, in the
+ * code itself (coefficients pre-divided by 255^k); codes 0..10 are on the
+ * linear segment. */
+static const float CURVE[6] = {
+    0.0010205572471022606f,
+    0.029987264424562454f / 255.0f,
+    0.5397341251373291f / (255.0f * 255.0f),
+    0.6094415187835693f / (255.0f * 255.0f * 255.0f),
+    -0.2392449975013733f / (255.0f * 255.0f * 255.0f * 255.0f),
+    0.059081509709358215f / (255.0f * 255.0f * 255.0f * 255.0f * 255.0f),
+};
+#define SEGMENT (1.0f / (255.0f * 12.92f))
+#define SCALE 1048576.0f
+
+/* The same operations as linear4, one value at a time. */
+static inline uint32_t linear_scalar(uint8_t code) {
+    float c = code, v;
+    if (code <= 10) {
+        v = c * (SEGMENT * SCALE) + 0.5f;
+    } else {
+        v = CURVE[5] * SCALE;
+        for (int k = 4; k >= 1; k--) v = v * c + CURVE[k] * SCALE;
+        v = v * c + (CURVE[0] * SCALE + 0.5f);
+    }
+    return (uint32_t)v;
+}
+
+static inline uint32x4_t linear4(uint16x4_t codes) {
+    uint32x4_t wide = vmovl_u16(codes);
+    float32x4_t c = vcvtq_f32_u32(wide);
+    float32x4_t v = vdupq_n_f32(CURVE[5] * SCALE);
+    for (int k = 4; k >= 1; k--) v = vmlaq_f32(vdupq_n_f32(CURVE[k] * SCALE), v, c);
+    /* The constant term carries the + 0.5 that rounds the truncation below. */
+    v = vmlaq_f32(vdupq_n_f32(CURVE[0] * SCALE + 0.5f), v, c);
+    float32x4_t segment = vmlaq_n_f32(vdupq_n_f32(0.5f), c, SEGMENT * SCALE);
+    /* An integer compare: GCC turns vcleq_f32 into per-lane VFP compares. */
+    return vcvtq_u32_f32(vbslq_f32(vcleq_u32(wide, vdupq_n_u32(10)), segment, v));
+}
+
+/* Pixels 2j and 2j + 1 come as even[j] and odd[j]. */
+static inline void store2(uint32_t *out, uint8x8_t even, uint8x8_t odd) {
+    uint8x8x2_t pixels = vzip_u8(even, odd);
+    uint16x8_t lo = vmovl_u8(pixels.val[0]), hi = vmovl_u8(pixels.val[1]);
+    vst1q_u32(out, linear4(vget_low_u16(lo)));
+    vst1q_u32(out + 4, linear4(vget_high_u16(lo)));
+    vst1q_u32(out + 8, linear4(vget_low_u16(hi)));
+    vst1q_u32(out + 12, linear4(vget_high_u16(hi)));
+}
+#define FROM_CODE(code) linear_scalar(code)
+#else
+static inline void store2(uint8_t *out, uint8x8_t even, uint8x8_t odd) {
+    uint8x8x2_t pixels = {{even, odd}};
+    vst2_u8(out, pixels); /* interleaves back to picture order */
+}
+#define FROM_CODE(code) (code)
+#endif
+
+/* Eight 8-bit codes from two halves of 32-bit fixed point (rounding already
+ * added), clamped to 0..255 as YuvToRgb does. */
+static inline uint8x8_t narrow8(int32x4_t lo, int32x4_t hi) {
+    return vqmovn_u16(vcombine_u16(vqshrun_n_s32(lo, PRECISION), vqshrun_n_s32(hi, PRECISION)));
+}
+
+/* Converts columns [x, end) of one row; x is even. Pixel x + i lands at
+ * index i of r, g, b. */
+static void convert(const uint8_t *luma, const uint8_t *uv, uint32_t x, uint32_t end,
+                    const prysm_yuv *k, sample *r, sample *g, sample *b) {
+    /* Black level, the 128 chroma offset and rounding, folded per channel. */
+    const int32_t base = ROUND - k->bias * k->y;
+    const int32x4_t kr = vdupq_n_s32(base - 128 * k->r_v);
+    const int32x4_t kg = vdupq_n_s32(base + 128 * (k->g_v + k->g_u));
+    const int32x4_t kb = vdupq_n_s32(base - 128 * k->b_u);
+    const int16_t lanes[4] = {(int16_t)k->y, (int16_t)k->r_v, (int16_t)k->g_v, (int16_t)k->g_u};
+    const int16x4_t c = vld1_s16(lanes);
+    const int16x4_t cb = vdup_n_s16((int16_t)k->b_u);
+    uint32_t i = 0;
+    for (; x + i + 16 <= end; i += 16) {
+        /* Luma split into even and odd pixels, so pixel pair j of both uses
+         * chroma sample j without duplicating it. */
+        uint8x8x2_t ys = vld2_u8(luma + x + i);
+        uint8x8x2_t uvs = vld2_u8(uv + x + i); /* 8 U, 8 V */
+        int16x8_t ye = vreinterpretq_s16_u16(vmovl_u8(ys.val[0]));
+        int16x8_t yo = vreinterpretq_s16_u16(vmovl_u8(ys.val[1]));
+        int16x8_t u = vreinterpretq_s16_u16(vmovl_u8(uvs.val[0]));
+        int16x8_t v = vreinterpretq_s16_u16(vmovl_u8(uvs.val[1]));
+        /* One channel: chroma term per pair (lo: pairs 0-3, hi: 4-7), plus luma. */
+#define CHANNEL(lo, hi, out)                                                         \
+    store2(out,                                                                      \
+           narrow8(vmlal_lane_s16(lo, vget_low_s16(ye), c, 0),                       \
+                   vmlal_lane_s16(hi, vget_high_s16(ye), c, 0)),                     \
+           narrow8(vmlal_lane_s16(lo, vget_low_s16(yo), c, 0),                       \
+                   vmlal_lane_s16(hi, vget_high_s16(yo), c, 0)))
+        CHANNEL(vmlal_lane_s16(kr, vget_low_s16(v), c, 1),
+                vmlal_lane_s16(kr, vget_high_s16(v), c, 1), r + i);
+        CHANNEL(vmlsl_lane_s16(vmlsl_lane_s16(kg, vget_low_s16(v), c, 2), vget_low_s16(u), c, 3),
+                vmlsl_lane_s16(vmlsl_lane_s16(kg, vget_high_s16(v), c, 2), vget_high_s16(u), c, 3),
+                g + i);
+        CHANNEL(vmlal_lane_s16(kb, vget_low_s16(u), cb, 0),
+                vmlal_lane_s16(kb, vget_high_s16(u), cb, 0), b + i);
+#undef CHANNEL
+    }
+    for (; x + i < end; i++) {
+        uint32_t pair = (x + i) & ~1u;
+        int32_t yy = ((int32_t)luma[x + i] - k->bias) * k->y;
+        int32_t u = (int32_t)uv[pair] - 128, v = (int32_t)uv[pair + 1] - 128;
+        r[i] = FROM_CODE(channel(yy + k->r_v * v));
+        g[i] = FROM_CODE(channel(yy - k->g_v * v - k->g_u * u));
+        b[i] = FROM_CODE(channel(yy + k->b_u * u));
+    }
+}
+
+/*
+ * Adds the linear light of n adjacent cells of one NV12 picture to sums.
+ *
+ * luma and chroma are the picture's planes, width bytes per row (width is
+ * even); cell i covers columns [edges[i], edges[i + 1]) of rows [y0, y1),
+ * with edges ascending and edges[n] <= width, and rows inside both planes.
+ * sums[3 * i .. 3 * i + 3] receives cell i's R, G, B in units of 2^-20.
+ * Each picture row is read once for all n cells.
+ */
+void prysm_nv12_cell_sums(const uint8_t *luma, const uint8_t *chroma, uint32_t width,
+                          uint32_t y0, uint32_t y1, const uint32_t *edges, uint32_t n,
+                          const prysm_yuv *k, const uint32_t *lut, uint64_t *sums) {
+    sample r[CHUNK], g[CHUNK], b[CHUNK];
+#ifdef PRYSM_NEON_ARITH
+    (void)lut;
+#define LINEAR(s) (s)
+#else
+#define LINEAR(s) lut[s]
+#endif
+    const uint32_t start = edges[0], end = edges[n];
+    for (uint32_t y = y0; y < y1; y++) {
+        const uint8_t *luma_row = luma + (size_t)y * width;
+        const uint8_t *uv_row = chroma + (size_t)(y / 2) * width;
+        uint32_t cell = 0;
+        for (uint32_t x = start & ~1u; x < end; x += CHUNK) {
+            uint32_t chunk_end = x + CHUNK < end ? x + CHUNK : end;
+            convert(luma_row, uv_row, x, chunk_end, k, r, g, b);
+            for (; cell < n; cell++) {
+                uint32_t lo = edges[cell] > x ? edges[cell] : x;
+                uint32_t hi = edges[cell + 1] < chunk_end ? edges[cell + 1] : chunk_end;
+                uint32_t sr = 0, sg = 0, sb = 0;
+                for (uint32_t i = lo - x; i < hi - x; i++) {
+                    sr += LINEAR(r[i]);
+                    sg += LINEAR(g[i]);
+                    sb += LINEAR(b[i]);
+                }
+                sums[3 * cell] += sr;
+                sums[3 * cell + 1] += sg;
+                sums[3 * cell + 2] += sb;
+                if (edges[cell + 1] > chunk_end) break; /* continues in the next chunk */
+            }
+        }
+    }
+#undef LINEAR
+}
