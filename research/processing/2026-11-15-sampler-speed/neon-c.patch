+    /// [`Self::average_linear_every`] for each of `cells` (viewport-relative
+    /// `[x0, y0, x1, y1]`) into `out`. With the NEON kernel, NV12 at step 1 is
+    /// summed a run of adjacent cells of one row band at a time, each picture
+    /// row read once; the sums are exact integers, so the grouping of cells
+    /// never changes a mean.
+    pub fn average_cells(&self, cells: &[[u32; 4]], step: u32, out: &mut [LinearColor]) {
+        #[cfg(prysm_neon)]
+        if step <= 1 && neon::average_nv12_cells(self, cells, out) {
+            return;
+        }
+        for (color, &[x0, y0, x1, y1]) in out.iter_mut().zip(cells) {
+            *color = self.average_linear_every(x0, y0, x1, y1, step);
+        }
+    }
