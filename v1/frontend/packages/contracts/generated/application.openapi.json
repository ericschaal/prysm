{
  "components": {
    "schemas": {
      "CaptureSettings": {
        "additionalProperties": true,
        "properties": {
          "kind": {
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "Failure": {
        "description": "A stable failure body. Local source chains stay in the process; only the\nmessage a user can act on is sent.",
        "properties": {
          "current": {
            "description": "The revision to retry against after `stale_revision`.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "field": {
            "description": "The rejected setting as a dotted path, such as `output.address`.",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/FailureKind"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "message"
        ],
        "type": "object"
      },
      "FailureKind": {
        "enum": [
          "invalid",
          "stale_revision",
          "faulted",
          "adapter",
          "unavailable",
          "timeout",
          "internal",
          "forbidden",
          "not_found",
          "method_not_allowed",
          "bad_request",
          "payload_too_large",
          "unsupported_media_type",
          "busy"
        ],
        "type": "string"
      },
      "LightingTarget": {
        "description": "What the user wants the LEDs to do.",
        "enum": [
          "off",
          "processed",
          "device_native"
        ],
        "type": "string"
      },
      "OutputSettings": {
        "additionalProperties": true,
        "properties": {
          "kind": {
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "Phase": {
        "description": "Where a faulted session stopped making progress.",
        "enum": [
          "running",
          "closing_source",
          "idling_output",
          "finishing"
        ],
        "type": "string"
      },
      "Processing": {
        "additionalProperties": false,
        "description": "Processing controls in plain units.",
        "properties": {
          "brightness_percent": {
            "format": "int32",
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "remove_black_bars": {
            "type": "boolean"
          },
          "sample_density": {
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          },
          "shadow_lift_percent": {
            "format": "int32",
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "smoothing_seconds": {
            "description": "Seconds; 0 disables smoothing.",
            "format": "float",
            "minimum": 0,
            "type": "number"
          },
          "spatial_reach_percent": {
            "format": "int32",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "brightness_percent",
          "shadow_lift_percent",
          "smoothing_seconds",
          "sample_density",
          "spatial_reach_percent",
          "remove_black_bars"
        ],
        "type": "object"
      },
      "Session": {
        "description": "What the runtime is actually doing.",
        "oneOf": [
          {
            "properties": {
              "state": {
                "enum": [
                  "stopped"
                ],
                "type": "string"
              }
            },
            "required": [
              "state"
            ],
            "type": "object"
          },
          {
            "properties": {
              "state": {
                "enum": [
                  "running"
                ],
                "type": "string"
              }
            },
            "required": [
              "state"
            ],
            "type": "object"
          },
          {
            "description": "The output shows its own effect.",
            "properties": {
              "state": {
                "enum": [
                  "native"
                ],
                "type": "string"
              }
            },
            "required": [
              "state"
            ],
            "type": "object"
          },
          {
            "description": "A session did not stop in time; only a restart recovers.",
            "properties": {
              "phase": {
                "$ref": "#/components/schemas/Phase"
              },
              "state": {
                "enum": [
                  "faulted"
                ],
                "type": "string"
              }
            },
            "required": [
              "phase",
              "state"
            ],
            "type": "object"
          }
        ]
      },
      "Settings": {
        "additionalProperties": false,
        "description": "Everything a user can change at runtime; adapter sections are tagged by `kind`.",
        "properties": {
          "capture": {
            "$ref": "#/components/schemas/CaptureSettings"
          },
          "output": {
            "$ref": "#/components/schemas/OutputSettings"
          },
          "processing": {
            "$ref": "#/components/schemas/Processing"
          }
        },
        "required": [
          "processing"
        ],
        "type": "object"
      },
      "SettingsReplaced": {
        "description": "Reply to a successful settings replacement. Applying them may still fail;\nthat failure appears in the state's `failure`.",
        "properties": {
          "revision": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "revision"
        ],
        "type": "object"
      },
      "SettingsRequest": {
        "additionalProperties": false,
        "description": "`PUT /api/v1/settings`: replace all settings if `expected` is current.",
        "properties": {
          "expected": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "settings": {
            "$ref": "#/components/schemas/Settings"
          }
        },
        "required": [
          "expected",
          "settings"
        ],
        "type": "object"
      },
      "State": {
        "description": "The observable runtime state, sent whole on every change.",
        "properties": {
          "failure": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Failure",
                "description": "Last lighting failure; cleared when lighting next starts."
              },
              {
                "type": "null"
              }
            ]
          },
          "revision": {
            "description": "Pass back as `expected` when replacing settings.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "session": {
            "$ref": "#/components/schemas/Session"
          },
          "settings": {
            "$ref": "#/components/schemas/Settings"
          },
          "surface_failures": {
            "description": "Surfaces that stopped. Lighting continues without them.",
            "items": {
              "$ref": "#/components/schemas/Failure"
            },
            "type": "array"
          },
          "target": {
            "$ref": "#/components/schemas/LightingTarget"
          }
        },
        "required": [
          "target",
          "session",
          "settings",
          "revision",
          "failure",
          "surface_failures"
        ],
        "type": "object"
      },
      "TargetRequest": {
        "additionalProperties": false,
        "description": "`PUT /api/v1/target`.",
        "properties": {
          "target": {
            "$ref": "#/components/schemas/LightingTarget"
          }
        },
        "required": [
          "target"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "JSON wire values and OpenAPI roots for Prysm surfaces",
    "license": {
      "identifier": "Apache-2.0",
      "name": "Apache-2.0"
    },
    "title": "Prysm application",
    "version": "1.0.0-alpha.0"
  },
  "openapi": "3.1.0",
  "paths": {}
}
