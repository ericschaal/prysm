@@ -0,0 +1,98 @@
+//! Direct WebSocket transport for the staged on-TV A/B/C experiment.
+use crate::{config::CaptureOptions, encoder::EncodedFrame};
+use anyhow::{Context, Result, bail, ensure};
+use prysm_metrics::{Codec, Content, Stage, WireBoundary};
+use prysm_webos_protocol::{ControlMessage, HELLO};
+use std::{
+    net::{SocketAddr, TcpStream, ToSocketAddrs},
+    sync::atomic::{AtomicBool, Ordering},
+    time::Duration,
+};
+use tungstenite::{Message, WebSocket, stream::MaybeTlsStream};
+
+pub struct Sender {
+    socket: WebSocket<MaybeTlsStream<TcpStream>>,
+    tcp: TcpStream,
+}
+
+impl Sender {
+    pub fn connect(_: SocketAddr) -> Result<(Self, ControlMessage)> {
+        let url = url::Url::parse(&std::env::var("PRYSM_BENCH_WS")?)?;
+        let host = url.host_str().context("missing host")?;
+        let port = url.port_or_known_default().context("missing port")?;
+        let address = (host, port)
+            .to_socket_addrs()?
+            .next()
+            .context("unresolved host")?;
+        let tcp = TcpStream::connect_timeout(&address, Duration::from_secs(3))?;
+        tcp.set_nodelay(true)?;
+        tcp.set_read_timeout(Some(Duration::from_secs(5)))?;
+        tcp.set_write_timeout(Some(Duration::from_millis(100)))?;
+        let _ = rustls::crypto::ring::default_provider().install_default();
+        let (socket, _) = tungstenite::client_tls(url.as_str(), tcp.try_clone()?)?;
+        let mut sender = Self { socket, tcp };
+        sender
+            .socket
+            .send(Message::binary(serde_json::to_vec(&HELLO)?))?;
+        let control = sender.control()?;
+        Ok((sender, control))
+    }
+
+    fn control(&mut self) -> Result<ControlMessage> {
+        let Message::Binary(bytes) = self.socket.read()? else {
+            bail!("expected binary Prysm control")
+        };
+        ControlMessage::decode(&bytes)
+    }
+
+    pub fn wait_for_capture(
+        &mut self,
+        mut message: ControlMessage,
+        stop: &AtomicBool,
+    ) -> Result<Option<CaptureOptions>> {
+        while !stop.load(Ordering::Relaxed) {
+            match message {
+                ControlMessage::CaptureSettings {
+                    refresh_rate_hz,
+                    capture_resolution: [width, height],
+                } => {
+                    return Ok(Some(CaptureOptions {
+                        fps: refresh_rate_hz.try_into()?,
+                        width,
+                        height,
+                    }));
+                }
+                ControlMessage::Idle => message = self.control()?,
+                ControlMessage::Hello { .. } => bail!("expected capture settings"),
+            }
+        }
+        Ok(None)
+    }
+
+    pub fn check_connection(&self) -> Result<()> {
+        ensure!(self.socket.can_write(), "receiver disconnected");
+        Ok(())
+    }
+
+    pub fn send(&mut self, frame: EncodedFrame<'_>, content: Content) -> Result<()> {
+        let header = frame.header;
+        let _write = prysm_metrics::timer(Stage::FrameWrite);
+        let mut bytes = Vec::with_capacity(prysm_webos_protocol::HEADER_LEN + frame.pixels.len());
+        bytes.extend_from_slice(&header.encode()?);
+        bytes.extend_from_slice(frame.pixels);
+        self.socket.send(Message::binary(bytes))?;
+        prysm_metrics::wire_frame(
+            WireBoundary::SocketAccepted,
+            header.format.into(),
+            Codec::from(&header),
+            content,
+            header.width,
+            header.height,
+        );
+        Ok(())
+    }
+
+    pub fn disconnect(&self) {
+        let _ = self.tcp.shutdown(std::net::Shutdown::Both);
+    }
+}
