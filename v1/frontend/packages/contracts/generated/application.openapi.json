{
  "components": {
    "schemas": {
      "CaptureSettings": {
        "additionalProperties": true,
        "properties": {
          "kind": {
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "ColorProfile": {
        "additionalProperties": false,
        "description": "A named color correction, such as one per console.",
        "properties": {
          "correction": {
            "$ref": "#/components/schemas/CorrectionControls"
          },
          "id": {
            "description": "Stable reference for `active_profile`; a UUID fits.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "name": {
            "description": "Without surrounding whitespace or control characters.",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "correction"
        ],
        "type": "object"
      },
      "CorrectionControls": {
        "additionalProperties": false,
        "description": "Correction controls, each -100 to 100; all zero is no correction.",
        "properties": {
          "hue": {
            "$ref": "#/components/schemas/HueControls"
          },
          "intensity": {
            "description": "Positive saturates, negative desaturates.",
            "format": "int32",
            "maximum": 100,
            "minimum": -100,
            "type": "integer"
          },
          "midtones": {
            "description": "Positive lightens midtones, negative darkens them.",
            "format": "int32",
            "maximum": 100,
            "minimum": -100,
            "type": "integer"
          },
          "tint": {
            "description": "Positive adds magenta, negative adds green.",
            "format": "int32",
            "maximum": 100,
            "minimum": -100,
            "type": "integer"
          },
          "warmth": {
            "description": "Positive warms, negative cools.",
            "format": "int32",
            "maximum": 100,
            "minimum": -100,
            "type": "integer"
          }
        },
        "required": [
          "warmth",
          "tint",
          "midtones",
          "intensity",
          "hue"
        ],
        "type": "object"
      },
      "Failure": {
        "description": "A stable failure body: the message a user can act on. An adapter failure\ncarries its cause chain (`context: cause: cause`), since the cause is what\nnames the problem (a device's error, a remote sender's reason).",
        "properties": {
          "current": {
            "description": "The revision to retry against after `stale_revision`.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "field": {
            "description": "The rejected setting as a dotted path, such as `output.address`.",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/FailureKind"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "message"
        ],
        "type": "object"
      },
      "FailureKind": {
        "enum": [
          "invalid",
          "stale_revision",
          "faulted",
          "adapter",
          "unavailable",
          "timeout",
          "internal",
          "forbidden",
          "not_found",
          "method_not_allowed",
          "bad_request",
          "payload_too_large",
          "unsupported_media_type",
          "busy"
        ],
        "type": "string"
      },
      "HueControls": {
        "additionalProperties": false,
        "description": "Hue shift per wheel anchor, each -100 to 100.",
        "properties": {
          "blue": {
            "format": "int32",
            "maximum": 100,
            "minimum": -100,
            "type": "integer"
          },
          "cyan": {
            "format": "int32",
            "maximum": 100,
            "minimum": -100,
            "type": "integer"
          },
          "green": {
            "format": "int32",
            "maximum": 100,
            "minimum": -100,
            "type": "integer"
          },
          "magenta": {
            "format": "int32",
            "maximum": 100,
            "minimum": -100,
            "type": "integer"
          },
          "red": {
            "format": "int32",
            "maximum": 100,
            "minimum": -100,
            "type": "integer"
          },
          "yellow": {
            "format": "int32",
            "maximum": 100,
            "minimum": -100,
            "type": "integer"
          }
        },
        "required": [
          "red",
          "yellow",
          "green",
          "cyan",
          "blue",
          "magenta"
        ],
        "type": "object"
      },
      "Input": {
        "description": "Whether frames are arriving, and how fast.",
        "properties": {
          "fps": {
            "description": "Frames per second over the last second, to one decimal.",
            "example": 29.9,
            "format": "float",
            "minimum": 0,
            "type": "number"
          },
          "receiving": {
            "description": "At least one frame arrived in the last second. `false` right after\nlighting starts and while the source is quiet (no signal, no sender).",
            "type": "boolean"
          }
        },
        "required": [
          "fps",
          "receiving"
        ],
        "type": "object"
      },
      "LightingTarget": {
        "description": "What the user wants the LEDs to do.",
        "enum": [
          "off",
          "processed",
          "device_native"
        ],
        "type": "string"
      },
      "OutputSettings": {
        "additionalProperties": true,
        "properties": {
          "kind": {
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "Phase": {
        "description": "Where a faulted session stopped making progress.",
        "enum": [
          "running",
          "closing_source",
          "idling_output",
          "finishing"
        ],
        "type": "string"
      },
      "PreviewColor": {
        "items": {},
        "maxItems": 3,
        "minItems": 3,
        "prefixItems": [
          {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          }
        ],
        "type": "array"
      },
      "PreviewColors": {
        "description": "The colors written to the LEDs, in display (sRGB) space and screen\norientation: `top` and `bottom` left to right, `left` and `right` top to\nbottom. Each edge has at most 256 entries spread evenly along it.",
        "properties": {
          "bottom": {
            "items": {
              "$ref": "#/components/schemas/PreviewColor"
            },
            "type": "array"
          },
          "left": {
            "items": {
              "$ref": "#/components/schemas/PreviewColor"
            },
            "type": "array"
          },
          "right": {
            "items": {
              "$ref": "#/components/schemas/PreviewColor"
            },
            "type": "array"
          },
          "top": {
            "items": {
              "$ref": "#/components/schemas/PreviewColor"
            },
            "type": "array"
          }
        },
        "required": [
          "top",
          "right",
          "bottom",
          "left"
        ],
        "type": "object"
      },
      "PreviewEvent": {
        "description": "One server-sent event of the preview stream.",
        "oneOf": [
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/PreviewFrame",
                "description": "A new processed frame and the colors written for it."
              },
              {
                "properties": {
                  "type": {
                    "enum": [
                      "frame"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ],
            "description": "A new processed frame and the colors written for it."
          },
          {
            "description": "Nothing to show: no session runs or it has not processed a frame yet.",
            "properties": {
              "type": {
                "enum": [
                  "idle"
                ],
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "description": "The latest frame cannot be shown, such as an undecoded MJPEG frame.",
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "unavailable"
                ],
                "type": "string"
              }
            },
            "required": [
              "message",
              "type"
            ],
            "type": "object"
          }
        ]
      },
      "PreviewFrame": {
        "description": "A downscaled JPEG of the captured frame, the sampled area and the colors.",
        "properties": {
          "colors": {
            "$ref": "#/components/schemas/PreviewColors"
          },
          "height": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "jpeg": {
            "description": "Base64 (standard alphabet, padded) baseline JPEG.",
            "type": "string"
          },
          "sequence": {
            "description": "Increases with every new frame, across sessions; equal means unchanged.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "source_height": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "source_width": {
            "description": "The captured frame's size in pixels; `viewport` is in these pixels.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "viewport": {
            "$ref": "#/components/schemas/PreviewViewport",
            "description": "The part of the frame that was sampled, after black-bar removal."
          },
          "width": {
            "description": "The JPEG's size in pixels: the source scaled to at most 480 on its\nlonger side, keeping its aspect ratio.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "sequence",
          "source_width",
          "source_height",
          "width",
          "height",
          "viewport",
          "colors",
          "jpeg"
        ],
        "type": "object"
      },
      "PreviewViewport": {
        "description": "A rectangle in source-frame pixels.",
        "properties": {
          "height": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "width": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "x": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "y": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "type": "object"
      },
      "Processing": {
        "additionalProperties": false,
        "description": "Processing controls in plain units.",
        "properties": {
          "active_profile": {
            "description": "The `id` of the applied profile; absent applies no correction.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "brightness_percent": {
            "format": "int32",
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "profiles": {
            "description": "Saved color corrections; ids are unique.",
            "items": {
              "$ref": "#/components/schemas/ColorProfile"
            },
            "maxItems": 32,
            "type": "array"
          },
          "remove_black_bars": {
            "type": "boolean"
          },
          "sample_density": {
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          },
          "shadow_lift_percent": {
            "format": "int32",
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "smoothing_seconds": {
            "description": "Seconds; 0 disables smoothing.",
            "format": "float",
            "minimum": 0,
            "type": "number"
          },
          "spatial_reach_percent": {
            "format": "int32",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "brightness_percent",
          "shadow_lift_percent",
          "smoothing_seconds",
          "sample_density",
          "spatial_reach_percent",
          "remove_black_bars"
        ],
        "type": "object"
      },
      "Session": {
        "description": "What the runtime is actually doing.",
        "oneOf": [
          {
            "properties": {
              "state": {
                "enum": [
                  "stopped"
                ],
                "type": "string"
              }
            },
            "required": [
              "state"
            ],
            "type": "object"
          },
          {
            "properties": {
              "state": {
                "enum": [
                  "running"
                ],
                "type": "string"
              }
            },
            "required": [
              "state"
            ],
            "type": "object"
          },
          {
            "description": "The output shows its own effect.",
            "properties": {
              "state": {
                "enum": [
                  "native"
                ],
                "type": "string"
              }
            },
            "required": [
              "state"
            ],
            "type": "object"
          },
          {
            "description": "A session did not stop in time; only a restart recovers.",
            "properties": {
              "phase": {
                "$ref": "#/components/schemas/Phase"
              },
              "state": {
                "enum": [
                  "faulted"
                ],
                "type": "string"
              }
            },
            "required": [
              "phase",
              "state"
            ],
            "type": "object"
          }
        ]
      },
      "Settings": {
        "additionalProperties": false,
        "description": "Everything a user can change at runtime; adapter sections are tagged by `kind`.",
        "properties": {
          "capture": {
            "$ref": "#/components/schemas/CaptureSettings"
          },
          "output": {
            "$ref": "#/components/schemas/OutputSettings"
          },
          "processing": {
            "$ref": "#/components/schemas/Processing"
          }
        },
        "required": [
          "processing"
        ],
        "type": "object"
      },
      "SettingsReplaced": {
        "description": "Reply to a successful settings replacement. Applying them may still fail;\nthat failure appears in the state's `failure`.",
        "properties": {
          "revision": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "revision"
        ],
        "type": "object"
      },
      "SettingsRequest": {
        "additionalProperties": false,
        "description": "`PUT /api/v1/settings`: replace all settings if `expected` is current.",
        "properties": {
          "expected": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "settings": {
            "$ref": "#/components/schemas/Settings"
          }
        },
        "required": [
          "expected",
          "settings"
        ],
        "type": "object"
      },
      "State": {
        "description": "The observable runtime state, sent whole on every change.",
        "properties": {
          "failure": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Failure",
                "description": "Last lighting failure; cleared when lighting next starts."
              },
              {
                "type": "null"
              }
            ]
          },
          "input": {
            "$ref": "#/components/schemas/Input",
            "description": "Frames arriving from the source, measured about once a second; absent\nwhile no session runs."
          },
          "revision": {
            "description": "Pass back as `expected` when replacing settings.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "session": {
            "$ref": "#/components/schemas/Session"
          },
          "settings": {
            "$ref": "#/components/schemas/Settings"
          },
          "surface_failures": {
            "description": "Surfaces that stopped. Lighting continues without them.",
            "items": {
              "$ref": "#/components/schemas/Failure"
            },
            "type": "array"
          },
          "target": {
            "$ref": "#/components/schemas/LightingTarget"
          }
        },
        "required": [
          "target",
          "session",
          "settings",
          "revision",
          "failure",
          "surface_failures"
        ],
        "type": "object"
      },
      "TargetRequest": {
        "additionalProperties": false,
        "description": "`PUT /api/v1/target`.",
        "properties": {
          "target": {
            "$ref": "#/components/schemas/LightingTarget"
          }
        },
        "required": [
          "target"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "JSON wire values and OpenAPI roots for Prysm surfaces",
    "license": {
      "identifier": "Apache-2.0",
      "name": "Apache-2.0"
    },
    "title": "Prysm application",
    "version": "1.0.0-alpha.0"
  },
  "openapi": "3.1.0",
  "paths": {}
}
