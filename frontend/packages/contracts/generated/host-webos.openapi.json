{
  "components": {
    "schemas": {
      "Behind": {
        "description": "What makes Prysm fall behind its source: for several seconds the frame\nloop had no slack, and this step took the larger share. A source that\njust sends fewer frames is never this.",
        "enum": [
          "processing",
          "output"
        ],
        "type": "string"
      },
      "Calibration": {
        "additionalProperties": false,
        "description": "A named color correction, such as one per console.",
        "properties": {
          "correction": {
            "$ref": "#/components/schemas/CorrectionControls"
          },
          "id": {
            "description": "Stable reference for `active_calibration`; a UUID fits.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "name": {
            "description": "Without surrounding whitespace or control characters.",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "correction"
        ],
        "type": "object"
      },
      "CalibrationPattern": {
        "additionalProperties": false,
        "description": "A calibration pattern shown on the TV: the body of\n`PUT /api/v1/calibration` and `State.calibration`.",
        "properties": {
          "pattern": {
            "$ref": "#/components/schemas/Pattern"
          },
          "uncorrected": {
            "description": "Apply no calibration while the pattern shows, to compare.",
            "type": "boolean"
          }
        },
        "required": [
          "pattern",
          "uncorrected"
        ],
        "type": "object"
      },
      "Candidate": {
        "description": "Something an adapter found that a person can pick instead of typing, one\nitem of `GET /api/v1/candidates/{section}/{kind}`.",
        "properties": {
          "detail": {
            "description": "Where it is or what it has, such as `192.168.1.40`.",
            "type": "string"
          },
          "fields": {
            "additionalProperties": true,
            "description": "The settings fields picking it fills, such as `{ \"device\": \"/dev/video0\" }`: part of the kind's settings, merged over what the person has.",
            "type": "object"
          },
          "label": {
            "description": "What a person recognises, such as the device's name.",
            "type": "string"
          },
          "led_count": {
            "description": "How many LEDs a found output device says it has, when it says.",
            "example": 120,
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "label",
          "fields"
        ],
        "type": "object"
      },
      "CaptureSettings": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/WebosSettings"
          }
        ]
      },
      "ChosenStyle": {
        "additionalProperties": false,
        "description": "The chosen style, as `Processing.style`.",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/Style"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "ColorsEvent": {
        "description": "One server-sent event of the colors stream.",
        "oneOf": [
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/LedColors",
                "description": "The colors last written to the LEDs, [`COLOR_SEGMENTS`] per edge\n(fewer when an edge has fewer samples). Sent only when they changed."
              },
              {
                "properties": {
                  "type": {
                    "enum": [
                      "colors"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ],
            "description": "The colors last written to the LEDs, [`COLOR_SEGMENTS`] per edge\n(fewer when an edge has fewer samples). Sent only when they changed."
          },
          {
            "description": "The LEDs are not showing Prysm's colors: lights off, the device's own\neffects, a source without frames, or no frame processed yet.",
            "properties": {
              "type": {
                "enum": [
                  "idle"
                ],
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          }
        ]
      },
      "CorrectionControls": {
        "additionalProperties": false,
        "description": "Correction controls, each -100 to 100; all zero is no correction.",
        "properties": {
          "blue": {
            "$ref": "#/components/schemas/PrimaryControls"
          },
          "green": {
            "$ref": "#/components/schemas/PrimaryControls"
          },
          "midtones": {
            "description": "Positive lightens midtones, negative darkens them.",
            "format": "int32",
            "maximum": 100,
            "minimum": -100,
            "type": "integer"
          },
          "red": {
            "$ref": "#/components/schemas/PrimaryControls"
          },
          "tint": {
            "description": "Positive adds magenta, negative adds green.",
            "format": "int32",
            "maximum": 100,
            "minimum": -100,
            "type": "integer"
          },
          "warmth": {
            "description": "Positive warms, negative cools.",
            "format": "int32",
            "maximum": 100,
            "minimum": -100,
            "type": "integer"
          }
        },
        "required": [
          "warmth",
          "tint",
          "midtones",
          "red",
          "green",
          "blue"
        ],
        "type": "object"
      },
      "DeviceReport": {
        "description": "What the lights say about themselves, from the output's own checks. Each\npart is absent while the output cannot tell, and all are while no session\nholds the output (no session, no frame yet, or released after 3 s without\nvideo; see `session.state` and `input.picture`). Prysm reports them and\nchanges none.",
        "properties": {
          "brightness_percent": {
            "description": "The lights' own brightness while it scales Prysm's colours (WLED: its\nmaster brightness and brightness factor): the share of Prysm's\nbrightness they show. Absent while it does not (WLED: \"Force max\nbrightness\" on).",
            "example": 40,
            "format": "int32",
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "issue": {
            "$ref": "#/components/schemas/OutputIssue",
            "description": "Why the lights are not showing Prysm's colours; absent while they\nshow them."
          },
          "led_count": {
            "description": "How many LEDs the lights say they have (WLED: its LED count). Prysm\nsends the configured `settings.output.leds` either way: a different\ncount leaves LEDs dark or colours unshown.",
            "example": 120,
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "Failure": {
        "description": "A failure reply (any non-2xx), tagged by `kind`: the message a user can\nact on, with what the kind needs to act on it.",
        "oneOf": [
          {
            "description": "Settings were rejected.",
            "properties": {
              "field": {
                "description": "The rejected setting as a dotted path, such as `output.address`;\nabsent when no one field is at fault.",
                "type": "string"
              },
              "kind": {
                "enum": [
                  "invalid"
                ],
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message",
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "Settings changed since `expected`.",
            "properties": {
              "current": {
                "description": "The revision to retry against.",
                "format": "int64",
                "minimum": 0,
                "type": "integer"
              },
              "kind": {
                "enum": [
                  "stale_revision"
                ],
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message",
              "current",
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "A device or adapter failed. Its message carries the cause chain.",
            "properties": {
              "kind": {
                "enum": [
                  "adapter"
                ],
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "section": {
                "$ref": "#/components/schemas/FailureSection",
                "description": "Which side failed, when the engine knows: the capture source or\nthe output."
              }
            },
            "required": [
              "message",
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "Calibration patterns need the `screen_sync` target.",
            "properties": {
              "kind": {
                "enum": [
                  "needs_screen_sync"
                ],
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message",
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "The runtime is faulted and accepts nothing until restarted.",
            "properties": {
              "kind": {
                "enum": [
                  "faulted"
                ],
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message",
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "The runtime or surface is stopping or stopped.",
            "properties": {
              "kind": {
                "enum": [
                  "unavailable"
                ],
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message",
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "An unexpected internal failure.",
            "properties": {
              "kind": {
                "enum": [
                  "internal"
                ],
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message",
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "enum": [
                  "forbidden"
                ],
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message",
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "enum": [
                  "not_found"
                ],
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message",
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "enum": [
                  "method_not_allowed"
                ],
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message",
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "The request was malformed: not JSON, or a field outside the settings\nunknown, missing or of the wrong type.",
            "properties": {
              "kind": {
                "enum": [
                  "bad_request"
                ],
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message",
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "The request body did not arrive in time.",
            "properties": {
              "kind": {
                "enum": [
                  "request_timeout"
                ],
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message",
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "enum": [
                  "payload_too_large"
                ],
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message",
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "enum": [
                  "unsupported_media_type"
                ],
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message",
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "A capture stream sender of another version.",
            "properties": {
              "kind": {
                "enum": [
                  "upgrade_required"
                ],
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message",
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "Too many concurrent requests or streams.",
            "properties": {
              "kind": {
                "enum": [
                  "busy"
                ],
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message",
              "kind"
            ],
            "type": "object"
          }
        ]
      },
      "FailureSection": {
        "description": "The side of the signal path a failure came from.",
        "enum": [
          "capture",
          "output"
        ],
        "type": "string"
      },
      "Input": {
        "description": "Whether frames are arriving, and how fast.",
        "properties": {
          "behind": {
            "$ref": "#/components/schemas/Behind",
            "description": "Which step keeps Prysm from keeping up with its source, if one does.\nAbsent while it keeps up."
          },
          "fps": {
            "description": "Frames per second over the last second, to one decimal.",
            "example": 29.9,
            "format": "float",
            "minimum": 0,
            "type": "number"
          },
          "latency": {
            "$ref": "#/components/schemas/Latency",
            "description": "The mean time per frame along the path, in two parts, over the last\nsecond. Absent when no frame reached the output."
          },
          "picture": {
            "$ref": "#/components/schemas/Picture",
            "description": "Whether frames arrived in the last second, and if not, why."
          },
          "sent_fps": {
            "description": "Frames per second whose colours were written to the output over the\nlast second, to one decimal.",
            "example": 29.9,
            "format": "float",
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "fps",
          "picture"
        ],
        "type": "object"
      },
      "Latency": {
        "description": "Mean milliseconds per frame along the path, measured by Prysm (not from\nthe screen, and not including the lights' own delay), in two parts.",
        "properties": {
          "capture_ms": {
            "description": "From the source capturing the frame to Prysm receiving it; present\nonly when every frame flushed in the window carried a capture time\n(video devices on macOS, and on Linux with monotonic stamps).",
            "example": 88,
            "format": "float",
            "minimum": 0,
            "type": "number"
          },
          "output_ms": {
            "description": "From Prysm receiving the frame to the output write for its colours\nreturning.",
            "example": 2.4,
            "format": "float",
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "output_ms"
        ],
        "type": "object"
      },
      "LedColor": {
        "items": {},
        "maxItems": 3,
        "minItems": 3,
        "prefixItems": [
          {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          }
        ],
        "type": "array"
      },
      "LedColors": {
        "description": "The colors written to the LEDs, in display (sRGB) space and screen\norientation: `top` and `bottom` left to right, `left` and `right` top to\nbottom. Each edge has entries spread evenly along it; how many depends on\nthe stream.",
        "properties": {
          "bottom": {
            "items": {
              "$ref": "#/components/schemas/LedColor"
            },
            "type": "array"
          },
          "left": {
            "items": {
              "$ref": "#/components/schemas/LedColor"
            },
            "type": "array"
          },
          "right": {
            "items": {
              "$ref": "#/components/schemas/LedColor"
            },
            "type": "array"
          },
          "top": {
            "items": {
              "$ref": "#/components/schemas/LedColor"
            },
            "type": "array"
          }
        },
        "required": [
          "top",
          "right",
          "bottom",
          "left"
        ],
        "type": "object"
      },
      "LedCounts": {
        "additionalProperties": false,
        "description": "LEDs per edge, as seen from the front of the screen. An omitted edge has\nnone. Together 1..=[`MAX_LEDS`].",
        "properties": {
          "bottom": {
            "default": 0,
            "format": "int32",
            "maximum": 16384,
            "minimum": 0,
            "type": "integer"
          },
          "left": {
            "default": 0,
            "format": "int32",
            "maximum": 16384,
            "minimum": 0,
            "type": "integer"
          },
          "right": {
            "default": 0,
            "format": "int32",
            "maximum": 16384,
            "minimum": 0,
            "type": "integer"
          },
          "top": {
            "default": 0,
            "format": "int32",
            "maximum": 16384,
            "minimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "LightingFailure": {
        "description": "Why the lighting is as it is: the failure a session state carries. An\nadapter failure carries its cause chain (`context: cause: cause`), since\nthe cause is what names the problem (a device's error, a remote sender's\nreason).",
        "oneOf": [
          {
            "description": "The saved settings do not validate, or cannot be read.",
            "properties": {
              "field": {
                "description": "The rejected setting as a dotted path, such as `output.address`;\nabsent when the settings as a whole are at fault.",
                "type": "string"
              },
              "kind": {
                "enum": [
                  "invalid"
                ],
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message",
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "A device or adapter failed.",
            "properties": {
              "kind": {
                "enum": [
                  "adapter"
                ],
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "section": {
                "$ref": "#/components/schemas/FailureSection",
                "description": "Which side failed, when the engine knows."
              }
            },
            "required": [
              "message",
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "An unexpected internal failure.",
            "properties": {
              "kind": {
                "enum": [
                  "internal"
                ],
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message",
              "kind"
            ],
            "type": "object"
          }
        ]
      },
      "LightingTarget": {
        "description": "What the user wants the LEDs to do.",
        "enum": [
          "off",
          "screen_sync",
          "effects"
        ],
        "type": "string"
      },
      "Mode": {
        "additionalProperties": false,
        "description": "One way a source delivers: every combination of these widths, heights\nand frame rates.",
        "properties": {
          "fps": {
            "$ref": "#/components/schemas/Span"
          },
          "height": {
            "$ref": "#/components/schemas/Span"
          },
          "width": {
            "$ref": "#/components/schemas/Span"
          }
        },
        "required": [
          "width",
          "height",
          "fps"
        ],
        "type": "object"
      },
      "Modes": {
        "description": "What a capture source delivers with the posted settings, the reply of\n`POST /api/v1/capture/modes`: `unknown` when it cannot reach its\nhardware; `known` with exactly these modes (none: nothing with these\nsettings). Ranges where the hardware takes any value in them, fixed\nmodes where it offers fixed ones.",
        "oneOf": [
          {
            "properties": {
              "status": {
                "enum": [
                  "unknown"
                ],
                "type": "string"
              }
            },
            "required": [
              "status"
            ],
            "type": "object"
          },
          {
            "properties": {
              "modes": {
                "items": {
                  "$ref": "#/components/schemas/Mode"
                },
                "type": "array"
              },
              "status": {
                "enum": [
                  "known"
                ],
                "type": "string"
              }
            },
            "required": [
              "modes",
              "status"
            ],
            "type": "object"
          }
        ]
      },
      "OutputIssue": {
        "description": "Why the lights are not showing Prysm's colours. Prysm keeps sending; they\nfollow again once the device takes the colours.",
        "enum": [
          "off",
          "overridden",
          "not_live",
          "other_sender",
          "unreachable"
        ],
        "type": "string"
      },
      "OutputSettings": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/WledSettings"
          }
        ]
      },
      "Pattern": {
        "description": "A calibration pattern, by its TV clip name.",
        "enum": [
          "gray_192",
          "red",
          "yellow",
          "green",
          "cyan",
          "blue",
          "magenta",
          "blue_pair",
          "red_pair",
          "green_pair",
          "coast",
          "garden",
          "dusk",
          "review_grid"
        ],
        "type": "string"
      },
      "Picture": {
        "description": "Whether frames arrive from the source. `arriving`: at least one frame in\nthe last second. `quiet`: none, and no reason given (no signal, no\nsender); also right after lighting starts. `refused`: none, because the\nsource's device refuses to share the video it shows (an LG TV that does\nnot allow its capture); frames come again once it does. Neither `quiet` nor\n`refused` is a failure: lighting waits for video, and releases the lights\nafter 3 s without it.",
        "enum": [
          "arriving",
          "quiet",
          "refused"
        ],
        "type": "string"
      },
      "PreviewEvent": {
        "description": "One server-sent event of the preview stream.",
        "oneOf": [
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/PreviewFrame",
                "description": "A new processed frame."
              },
              {
                "properties": {
                  "type": {
                    "enum": [
                      "frame"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ],
            "description": "A new processed frame."
          },
          {
            "description": "Nothing to show: no session runs or it has not processed a frame yet.",
            "properties": {
              "type": {
                "enum": [
                  "idle"
                ],
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "description": "The latest frame cannot be shown, such as an empty frame.",
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "unavailable"
                ],
                "type": "string"
              }
            },
            "required": [
              "message",
              "type"
            ],
            "type": "object"
          }
        ]
      },
      "PreviewFrame": {
        "description": "A downscaled JPEG of the captured frame and the sampled area.",
        "properties": {
          "height": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "jpeg": {
            "description": "Base64 (standard alphabet, padded) baseline JPEG.",
            "type": "string"
          },
          "sequence": {
            "description": "Increases with every new frame, across sessions; equal means unchanged.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "source_height": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "source_width": {
            "description": "The captured frame's size in pixels; `viewport` is in these pixels.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "viewport": {
            "$ref": "#/components/schemas/PreviewViewport",
            "description": "The part of the frame that was sampled, after black-bar removal."
          },
          "width": {
            "description": "The JPEG's size in pixels: the source scaled to at most 480 on its\nlonger side, keeping its aspect ratio.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "sequence",
          "source_width",
          "source_height",
          "width",
          "height",
          "viewport",
          "jpeg"
        ],
        "type": "object"
      },
      "PreviewViewport": {
        "description": "A rectangle in source-frame pixels.",
        "properties": {
          "height": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "width": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "x": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "y": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "type": "object"
      },
      "PrimaryControls": {
        "additionalProperties": false,
        "description": "One picture primary's controls, each -100 to 100; white never moves.",
        "properties": {
          "hue": {
            "description": "Positive turns toward the next primary in red, green, blue order,\nnegative toward the previous one.",
            "format": "int32",
            "maximum": 100,
            "minimum": -100,
            "type": "integer"
          },
          "strength": {
            "description": "Negative makes the colour softer, positive stronger.",
            "format": "int32",
            "maximum": 100,
            "minimum": -100,
            "type": "integer"
          }
        },
        "required": [
          "hue",
          "strength"
        ],
        "type": "object"
      },
      "Processing": {
        "additionalProperties": false,
        "description": "Processing controls in plain units.",
        "properties": {
          "active_calibration": {
            "description": "The `id` of the applied calibration; absent applies no correction.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "brightness_percent": {
            "format": "int32",
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "calibrations": {
            "description": "Saved color corrections; ids are unique.",
            "items": {
              "$ref": "#/components/schemas/Calibration"
            },
            "maxItems": 32,
            "type": "array"
          },
          "custom_style": {
            "$ref": "#/components/schemas/StyleValues",
            "description": "The user's own values, applied while the style is `custom` and kept\nwhile another is chosen; absent until first tuned."
          },
          "remove_black_bars": {
            "type": "boolean"
          },
          "sample_density": {
            "description": "Samples per 1000 px of edge, measured on the picture scaled down to\n640x360: the same value gives the same samples at any capture size.\nAt most one sample per sampling-grid cell along an edge (128 along the\nlonger side): density 200 reaches it for 16:9 pictures of 640x360 or\nmore, a higher one for squarer or smaller pictures.",
            "format": "int32",
            "maximum": 512,
            "minimum": 1,
            "type": "integer"
          },
          "style": {
            "$ref": "#/components/schemas/ChosenStyle"
          }
        },
        "required": [
          "brightness_percent",
          "style",
          "sample_density",
          "remove_black_bars"
        ],
        "type": "object"
      },
      "Session": {
        "description": "What the runtime is actually doing. Screen sync carries no failure: it\nruns on valid settings and has reached its target.",
        "oneOf": [
          {
            "description": "No session; the lights are not driven.",
            "properties": {
              "failure": {
                "$ref": "#/components/schemas/LightingFailure",
                "description": "Why the target is not reached, why the lights may not be off, or\nthat the saved settings do not validate; absent while none does."
              },
              "state": {
                "enum": [
                  "stopped"
                ],
                "type": "string"
              }
            },
            "required": [
              "state"
            ],
            "type": "object"
          },
          {
            "description": "The lights follow the screen.",
            "properties": {
              "state": {
                "enum": [
                  "screen_sync"
                ],
                "type": "string"
              }
            },
            "required": [
              "state"
            ],
            "type": "object"
          },
          {
            "description": "The lights show their own effects.",
            "properties": {
              "failure": {
                "$ref": "#/components/schemas/LightingFailure",
                "description": "Why screen sync, asked from the effects, did not start, or that\nthe saved settings do not validate; absent while none does."
              },
              "state": {
                "enum": [
                  "effects"
                ],
                "type": "string"
              }
            },
            "required": [
              "state"
            ],
            "type": "object"
          },
          {
            "description": "A session did not stop in time, or did not confirm its source's\nrelease; only a restart recovers.",
            "properties": {
              "message": {
                "description": "What did not finish, for people.",
                "type": "string"
              },
              "state": {
                "enum": [
                  "faulted"
                ],
                "type": "string"
              }
            },
            "required": [
              "message",
              "state"
            ],
            "type": "object"
          }
        ]
      },
      "Settings": {
        "additionalProperties": false,
        "description": "Everything a user can change at runtime; adapter sections are tagged by `kind`.",
        "properties": {
          "capture": {
            "$ref": "#/components/schemas/CaptureSettings"
          },
          "output": {
            "$ref": "#/components/schemas/OutputSettings"
          },
          "processing": {
            "$ref": "#/components/schemas/Processing"
          }
        },
        "required": [
          "processing"
        ],
        "type": "object"
      },
      "SettingsReplaced": {
        "description": "Reply to a successful settings replacement. Applying them may still fail;\nthat failure appears in the state's `session`.",
        "properties": {
          "revision": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "revision"
        ],
        "type": "object"
      },
      "SettingsRequest": {
        "additionalProperties": false,
        "description": "`PUT /api/v1/settings`: replace all settings if `expected` is current.",
        "properties": {
          "expected": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "settings": {
            "$ref": "#/components/schemas/Settings"
          }
        },
        "required": [
          "expected",
          "settings"
        ],
        "type": "object"
      },
      "Span": {
        "additionalProperties": false,
        "description": "`min`, `min + step`, … up to `max` (always reached); a single value is\n`min == max` with step 1.",
        "properties": {
          "max": {
            "example": 1920,
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "min": {
            "example": 2,
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "step": {
            "example": 2,
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "min",
          "max",
          "step"
        ],
        "type": "object"
      },
      "State": {
        "description": "The observable runtime state, sent whole on every change.",
        "properties": {
          "calibration": {
            "$ref": "#/components/schemas/CalibrationPattern",
            "description": "The calibration pattern the TV shows, set by `PUT /api/v1/calibration`;\nabsent while not calibrating. Never saved."
          },
          "device": {
            "$ref": "#/components/schemas/DeviceReport",
            "description": "What the lights say about themselves, from the output's own checks\n(about once a second). Empty while no session holds the output: no\nsession, or one that has no frame yet or released the output after 3 s\nwithout video; `session.state` and `input.picture` say which."
          },
          "input": {
            "$ref": "#/components/schemas/Input",
            "description": "Frames arriving from the source, measured about once a second; absent\nwhile no session runs."
          },
          "revision": {
            "description": "Pass back as `expected` when replacing settings.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "session": {
            "$ref": "#/components/schemas/Session"
          },
          "settings": {
            "$ref": "#/components/schemas/Settings"
          },
          "surface_failures": {
            "description": "Surfaces that stopped. Lighting continues without them.",
            "items": {
              "$ref": "#/components/schemas/Failure"
            },
            "type": "array"
          },
          "target": {
            "$ref": "#/components/schemas/LightingTarget"
          },
          "version": {
            "description": "The Prysm product version, such as `1.0.0` or `1.0.0-rc.1`.",
            "example": "1.0.0",
            "type": "string"
          }
        },
        "required": [
          "version",
          "target",
          "session",
          "device",
          "settings",
          "revision",
          "surface_failures"
        ],
        "type": "object"
      },
      "Style": {
        "description": "A style by name: a built-in set of the picture-taste knobs, or `custom`,\nthe user's own values.",
        "enum": [
          "natural",
          "calm",
          "vivid",
          "game",
          "custom"
        ],
        "type": "string"
      },
      "StyleValues": {
        "additionalProperties": false,
        "description": "The picture-taste knobs a style sets, in plain units.",
        "properties": {
          "brightness_ramp_seconds": {
            "description": "Seconds, the least time from dark to full brightness; 0 sets no limit.",
            "format": "float",
            "maximum": 2,
            "minimum": 0,
            "type": "number"
          },
          "color_focus_percent": {
            "description": "How much each light keeps the colour next to it, taking less from the\nrest of the picture; 0 is the plain average.",
            "format": "int32",
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "cut_response_percent": {
            "description": "How much of a scene cut the lights take at once; 0 eases a cut in\nlike any other change.",
            "format": "int32",
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "dark_floor_percent": {
            "description": "The least luminance the lights keep, as a neutral white glow, in\npercent of full light; 0 lets them go fully dark.",
            "format": "int32",
            "maximum": 20,
            "minimum": 0,
            "type": "integer"
          },
          "saturation_boost_percent": {
            "description": "Scales each light's chroma by 1 + p/100; 0 leaves colours as they are.",
            "format": "int32",
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "smoothing_seconds": {
            "description": "Seconds to complete most of a change; 0 disables smoothing.",
            "format": "float",
            "maximum": 2,
            "minimum": 0,
            "type": "number"
          },
          "spatial_reach_percent": {
            "description": "Edge depth: how far into the picture each light looks, in percent of\nthe picture's height.",
            "format": "int32",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "smoothing_seconds",
          "cut_response_percent",
          "brightness_ramp_seconds",
          "spatial_reach_percent",
          "color_focus_percent",
          "saturation_boost_percent",
          "dark_floor_percent"
        ],
        "type": "object"
      },
      "TargetRequest": {
        "additionalProperties": false,
        "description": "`PUT /api/v1/target`.",
        "properties": {
          "target": {
            "$ref": "#/components/schemas/LightingTarget"
          }
        },
        "required": [
          "target"
        ],
        "type": "object"
      },
      "WebosSettings": {
        "additionalProperties": false,
        "description": "`{ \"kind\": \"webos\", \"width\": 640, \"height\": 360, \"fps\": 30, \"include_ui\": true }`\n\nLG's capture driver scales to `width`×`height` and paces at `fps`; all\nfields are optional. `include_ui` blends on-screen menus into the capture\n(LG dump mode 3) instead of video only (mode 2).",
        "properties": {
          "fps": {
            "default": 30,
            "format": "int32",
            "maximum": 60,
            "minimum": 1,
            "type": "integer"
          },
          "height": {
            "default": 360,
            "description": "Even, 2 to 1080.",
            "format": "int32",
            "maximum": 1080,
            "minimum": 2,
            "multipleOf": 2,
            "type": "integer"
          },
          "include_ui": {
            "default": true,
            "description": "Capture on-screen menus over the video and, when nothing is playing\n(such as the Home screen), the TV's own screens; false: video only.",
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "webos"
            ],
            "type": "string"
          },
          "width": {
            "default": 640,
            "description": "Even, 2 to 1920.",
            "format": "int32",
            "maximum": 1920,
            "minimum": 2,
            "multipleOf": 2,
            "type": "integer"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "WledSettings": {
        "additionalProperties": false,
        "description": "Where the device is, how many LEDs each screen edge has, and whether\ndim colours are dithered (on unless `false`):\n\n```json\n{ \"kind\": \"wled\", \"address\": \"wled.local\",\n  \"leds\": { \"top\": 96, \"right\": 54, \"bottom\": 96, \"left\": 54 },\n  \"dither\": true }\n```",
        "properties": {
          "address": {
            "description": "Host name or unicast IP address of the device, with an optional HTTP\nport (default 80): `wled.local`, `192.168.1.50`, `wled.local:8080` or\n`[fe80::1]:8080`. No scheme or path; WLED serves plain HTTP. Names are\nresolved each time the output opens. Colours always go to UDP port 4048.",
            "examples": [
              "wled.local",
              "192.168.1.50",
              "wled.local:8080",
              "[fe80::1]:8080"
            ],
            "minLength": 1,
            "type": "string"
          },
          "dither": {
            "default": true,
            "description": "Mix neighbouring LEDs between the few levels WLED shows for dim\ncolours, so they fade evenly and keep their hue. False: each LED\ntakes the nearest byte, for a strip on which dark scenes twinkle.",
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "wled"
            ],
            "type": "string"
          },
          "leds": {
            "$ref": "#/components/schemas/LedCounts"
          }
        },
        "required": [
          "kind",
          "address",
          "leds"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "JSON wire values and OpenAPI roots for Prysm surfaces",
