+/// The NEON cell sums of `nv12_neon.c` (built by `build.rs` where NEON exists).
+#[cfg(prysm_neon)]
+#[allow(unsafe_code, reason = "one FFI call into the NEON kernel")]
+mod neon {
+    use super::FrameView;
+    use prysm_core::{LinearColor, PixelFormat, YuvToRgb};
+    use std::sync::OnceLock;
+
+    /// Linear light per sRGB code in units of 2^-20, as the kernel sums it.
+    const SCALE: f64 = 1_048_576.0;
+
+    unsafe extern "C" {
+        /// See `nv12_neon.c` for the contract.
+        fn prysm_nv12_cell_sums(
+            luma: *const u8,
+            chroma: *const u8,
+            width: u32,
+            y0: u32,
+            y1: u32,
+            edges: *const u32,
+            n: u32,
+            coefficients: *const [i32; 6],
+            table: *const [u32; 256],
+            sums: *mut u64,
+        );
+    }
+
+    #[allow(
+        clippy::cast_possible_truncation,
+        clippy::cast_sign_loss,
+        reason = "linear light in 0..=1 scaled to 2^20"
+    )]
+    fn table() -> &'static [u32; 256] {
+        static TABLE: OnceLock<[u32; 256]> = OnceLock::new();
+        TABLE.get_or_init(|| {
+            std::array::from_fn(|code| {
+                let srgb = code as f64 / 255.0;
+                let linear = if srgb <= 0.040_45 {
+                    srgb / 12.92
+                } else {
+                    ((srgb + 0.055) / 1.055).powf(2.4)
+                };
+                (linear * SCALE).round() as u32
+            })
+        })
+    }
+
+    /// Fills `out` and returns true for an NV12 frame whose coefficients fit
+    /// the kernel's 16-bit multipliers; otherwise returns false untouched.
+    #[allow(
+        clippy::cast_possible_truncation,
+        clippy::cast_precision_loss,
+        reason = "means of bounded sums, returned as f32 colour"
+    )]
+    pub(super) fn average_nv12_cells(
+        view: &FrameView,
+        cells: &[[u32; 4]],
+        out: &mut [LinearColor],
+    ) -> bool {
+        let PixelFormat::NV12 { range, matrix } = view.frame.format() else {
+            return false;
+        };
+        let Some((luma, chroma)) = view.frame.nv12_planes() else {
+            return false;
+        };
+        let coefficients = YuvToRgb::new(range, matrix).coefficients();
+        let (width, height) = (view.frame.width(), view.frame.height());
+        if coefficients[1..].iter().any(|&c| i16::try_from(c).is_err()) || width % 2 != 0 {
+            return false;
+        }
+        let row = width as usize;
+        let clip_x = |x: u32| view.viewport.x.saturating_add(x).min(width);
+        let clip_y = |y: u32| view.viewport.y.saturating_add(y).min(height);
+        let (mut edges, mut sums) = (Vec::new(), Vec::new());
+        let mut start = 0;
+        while start < cells.len() {
+            // A run: cells of the same rows, each starting where the last ends.
+            let [_, y0, _, y1] = cells[start];
+            let mut end = start + 1;
+            // (Research: `PRYSM_NEON=cell` keeps every run to one cell.)
+            while end < cells.len()
+                && !cfg!(prysm_neon_per_cell)
+                && cells[end][1] == y0
+                && cells[end][3] == y1
+                && cells[end][0] == cells[end - 1][2]
+            {
+                end += 1;
+            }
+            let run = &cells[start..end];
+            let (y0, y1) = (clip_y(y0), clip_y(y1));
+            edges.clear();
+            edges.push(clip_x(run[0][0]));
+            edges.extend(run.iter().map(|cell| clip_x(cell[2])));
+            let ascending = edges.windows(2).all(|pair| pair[0] <= pair[1]);
+            let rows_present =
+                luma.len() >= y1 as usize * row && chroma.len() >= (y1 as usize).div_ceil(2) * row;
+            if !ascending || !rows_present {
+                for (color, &[x0, y0, x1, y1]) in out[start..end].iter_mut().zip(run) {
+                    *color = view.average_linear_every(x0, y0, x1, y1, 1);
+                }
+                start = end;
+                continue;
+            }
+            sums.clear();
+            sums.resize(run.len() * 3, 0_u64);
+            if y0 < y1 && edges[0] < edges[run.len()] {
+                // SAFETY: rows y0..y1 lie inside both planes (checked above),
+                // `edges` holds run.len() + 1 ascending columns <= width, and
+                // `sums` holds 3 * run.len() values.
+                unsafe {
+                    prysm_nv12_cell_sums(
+                        luma.as_ptr(),
+                        chroma.as_ptr(),
+                        width,
+                        y0,
+                        y1,
+                        edges.as_ptr(),
+                        run.len() as u32,
+                        &raw const coefficients,
+                        table(),
+                        sums.as_mut_ptr(),
+                    );
+                }
+            }
+            let means = out[start..end].iter_mut().zip(sums.as_chunks::<3>().0);
+            for ((color, sum), pair) in means.zip(edges.windows(2)) {
+                let count = u64::from(pair[1] - pair[0]) * u64::from(y1.saturating_sub(y0));
+                *color = if count == 0 {
+                    LinearColor::black()
+                } else {
+                    let scale = count as f64 * SCALE;
+                    let [r, g, b] = [0, 1, 2].map(|c| (sum[c] as f64 / scale) as f32);
+                    LinearColor::new(r, g, b)
+                };
+            }
+            start = end;
+        }
+        true
+    }
 }
 
