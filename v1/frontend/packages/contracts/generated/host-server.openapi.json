        "additionalProperties": false,
        "description": "Fixed-width LED counts have the same JSON range on every host architecture.",
        "properties": {
          "address": {
            "type": "string"
          },
          "leds": {
            "items": {},
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "maximum": 4294967295,
                "minimum": 0,
                "type": "integer"
              },
              {
                "maximum": 4294967295,
                "minimum": 0,
                "type": "integer"
              },
              {
                "maximum": 4294967295,
                "minimum": 0,
                "type": "integer"
              },
              {
                "maximum": 4294967295,
                "minimum": 0,
                "type": "integer"
              }
            ],
            "type": "array"
          }
        },
        "required": [
          "address",
          "leds"
        ],
        "type": "object"
      }
