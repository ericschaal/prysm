{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "packages/**/*.tsx",
    "hosts/**/*.tsx",
    "testkit/**/*.ts",
    "testkit/**/*.tsx",
    "tests/**/*.tsx",
    "packages/**/*.ts"
  ]
}
