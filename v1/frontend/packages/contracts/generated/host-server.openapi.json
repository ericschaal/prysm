            "type": "string"
          }
        },
        "required": [
          "instance",
          "sequence"
        ],
        "type": "object"
      },
      "DeviceCaptureSettings": {
        "description": "These choices belong to the device adapter, never the shared application.",
        "oneOf": [
          {
            "properties": {
              "path": {
                "type": "string"
              },
              "rate": {
                "format": "int32",
                "maximum": 4294967295,
                "minimum": 1,
                "type": "integer"
              },
              "resolution": {
                "items": {},
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "maximum": 3840,
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "maximum": 2160,
                    "minimum": 1,
                    "type": "integer"
                  }
                ],
                "type": "array"
              },
              "source": {
                "enum": [
                  "device"
                ],
                "type": "string"
              }
            },
            "required": [
              "path",
              "resolution",
              "rate",
              "source"
            ],
            "type": "object"
          },
          {
            "properties": {
              "path": {
                "type": "string"
              },
              "rate": {
                "format": "int32",
                "maximum": 4294967295,
                "minimum": 1,
                "type": "integer"
              },
              "resolution": {
                "items": {},
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "maximum": 3840,
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "maximum": 2160,
                    "minimum": 1,
                    "type": "integer"
                  }
                ],
                "type": "array"
              },
              "source": {
                "enum": [
                  "file"
                ],
                "type": "string"
              }
            },
            "required": [
              "path",
              "resolution",
              "rate",
              "source"
            ],
            "type": "object"
          }
        ]
      },
      "EndPresentationRequest": {
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OperationId"
          },
          "session": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "session"
        ],
        "type": "object"
      },
      "Failure": {
        "description": "Local source errors and their implementation types never enter the wire format.",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/FailureKind"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "message"
        ],
        "type": "object"
      },
      "FailureKind": {
        "enum": [
          "unavailable",
          "invalid",
          "conflict",
          "outcome_unknown",
          "cleanup_pending",
          "unknown_operation",
          "adapter",
          "recovery_required",
          "interrupted"
        ],
        "type": "string"
      },
      "InstanceId": {
        "pattern": "^[1-9][0-9]*$",
        "type": "string"
      },
      "LightingTarget": {
        "enum": [
          "off",
          "processed",
          "device_native"
        ],
        "type": "string"
      },
      "OperationId": {
        "properties": {
          "instance": {
            "$ref": "#/components/schemas/InstanceId"
          },
          "request": {
            "pattern": "^[1-9][0-9]*$",
            "type": "string"
          }
        },
        "required": [
