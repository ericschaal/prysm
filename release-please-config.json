{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "version-file": "VERSION",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "draft": true,
  "force-tag-creation": true,
  "packages": {
    ".": {
      "extra-files": [
        {
          "type": "toml",
          "path": "apps/prysm/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name=='prysm' || @.name.value=='prysm')].version"
        },
        "crates/web/prysm-webos/public/appinfo.json",
        {
          "type": "generic",
          "path": "compose.yaml"
        },
        {
          "type": "generic",
          "path": "packaging/docker/compose.truenas.yaml"
        }
      ]
    }
  }
}
